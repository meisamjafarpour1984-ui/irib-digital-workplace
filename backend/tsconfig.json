{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["src/*"],
      "@common/*": ["src/common/*"],
      "@modules/*": ["src/modules/*"],
      "@packages/*": ["packages/*"]
    }
  },
  "include": [
    "src/main.ts",
    "src/app.module.ts",
    "src/prisma/**/*.ts",
    "src/modules/health/**/*.ts",
    "src/modules/iam/**/*.ts",
    "src/modules/content/**/*.ts",
    "src/modules/forms/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/modules/iam/user-management.controller.ts",
    "src/modules/iam/user-management.service.ts"
  ]
}
