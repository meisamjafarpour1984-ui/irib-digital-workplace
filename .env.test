# Application
NODE_ENV=test
ENVIRONMENT=test
PORT=3001

# Database
DATABASE_URL=postgresql://irib_admin:irib_secret_2024@postgres:5432/irib_dwp
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=irib_admin
DATABASE_PASSWORD=irib_secret_2024
DATABASE_NAME=irib_dwp

# Redis
REDIS_URL=redis://:irib_redis_2024@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=irib_redis_2024

# JWT
JWT_SECRET=test-secret-change-in-production-min-32-chars-long
JWT_ISSUER=irib-dwp
JWT_AUDIENCE=irib-dwp-web

# OpenSearch
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_NODE=http://opensearch:9200
OPENSEARCH_INDEX=irib-dwp-content

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=irib_minio_admin
MINIO_SECRET_KEY=irib_minio_2024
MINIO_BUCKET=irib-dwp-media
USE_MINIO=true

# Keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=irib-dwp
KEYCLOAK_CLIENT_ID=irib-dwp-web
KEYCLOAK_CLIENT_SECRET=irib-dwp-client-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
AUTH_TYPE=local

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_ENABLED=false

# Media
MAX_FILE_SIZE=52428800
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml,video/mp4,video/webm,audio/mpeg,audio/wav,application/pdf

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# SMS (for testing - use Mailhog)
SMS_PROVIDER=mock
SMS_API_URL=http://mailhog:8025
SMS_API_KEY=test-key

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001
